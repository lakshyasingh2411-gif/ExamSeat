PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# local (default) uses a SQLite file, Azure SQL uses mssql
DB_DRIVER=sqlite
SQLITE_FILE=./examseat.db

# Azure SQL Database (set DB_DRIVER=mssql)
DB_SERVER=your-server.database.windows.net
DB_NAME=examseat
DB_USER=your-admin-user
DB_PASSWORD=your-password

# first-run demo accounts
ADMIN_PASSWORD=admin123
INVIGILATOR_PASSWORD=inv123
DEFAULT_STUDENT_PASSWORD=student123
